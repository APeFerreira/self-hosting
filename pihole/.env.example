# Copy this file to .env. These SSH-only defaults expose nothing publicly.
# After WireGuard is running, set PIHOLE_DNS_BIND_IP to the VPS's wg0 address,
# for example 10.66.66.1. Keep PIHOLE_WEB_BIND_IP on loopback to administer
# through an SSH tunnel, or set it to the wg0 address for VPN-only web access.
# Use only addresses displayed by `ip -brief -4 address` on the VPS.
TZ=Etc/UTC
PIHOLE_DNS_BIND_IP=127.0.0.1
PIHOLE_WEB_BIND_IP=127.0.0.1
# These are host-side ports. They do not need OCI ingress rules when the web
# interface stays on 127.0.0.1 or the WireGuard address.
PIHOLE_WEB_HTTP_PORT=8080
PIHOLE_WEB_HTTPS_PORT=8443
